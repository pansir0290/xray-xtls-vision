#!/bin/bash

# =================================================================
# 🎬 Sing-box + AnyTLS + Caddy 阳谋一体化完全体 (最新版 1.11+ 兼容)
# =================================================================

if [ "$EUID" -ne 0 ]; then echo "❌ 请使用 root 权限运行"; exit 1; fi

# 1. 获取参数
read -p "请输入域名: " DOMAIN
read -p "请输入邮箱: " EMAIL
PASSWORD=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 16)

# 2. 彻底清理与依赖安装
systemctl stop sing-box caddy 2>/dev/null
apt-get update && apt-get install -y curl socat psmisc

# 3. 安装 Caddy
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg 2>/dev/null
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list >/dev/null
apt-get update && apt-get install -y caddy

# 4. 获取 Sing-box 最新版 (避开不稳定的软件源)
LATEST_VERSION=$(curl -s https://api.github.com/repos/SagerNet/sing-box/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' | sed 's/v//')
curl -Lo /tmp/sing-box.deb "https://github.com/SagerNet/sing-box/releases/download/v${LATEST_VERSION}/sing-box_${LATEST_VERSION}_linux_amd64.deb"
dpkg -i /tmp/sing-box.deb

# 5. 申请证书
curl https://get.acme.sh | sh -s email=$EMAIL
~/.acme.sh/acme.sh --set-default-ca --server letsencrypt
~/.acme.sh/acme.sh --issue -d $DOMAIN --standalone --keylength ec-256
mkdir -p /var/lib/sing-box/certs
~/.acme.sh/acme.sh --install-cert -d $DOMAIN --ecc --fullchain-file /var/lib/sing-box/certs/fullchain.pem --key-file /var/lib/sing-box/certs/private.key

# 6. 生成最新版兼容配置 (采用最新 SNI 回落逻辑)
mkdir -p /etc/sing-box
cat << EOF > /etc/sing-box/config.json
{
  "log": { "level": "info" },
  "inbounds": [
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": 443,
      "users": [ { "name": "pansir", "password": "$PASSWORD" } ],
      "tls": {
        "enabled": true,
        "server_name": "$DOMAIN",
        "certificate_path": "/var/lib/sing-box/certs/fullchain.pem",
        "key_path": "/var/lib/sing-box/certs/private.key"
      }
    }
  ],
  "outbounds": [ { "type": "direct", "tag": "direct" } ]
}
EOF

# 7. 配置 Caddy 伪装并启动
cat << EOF > /etc/caddy/Caddyfile
$DOMAIN {
    reverse_proxy localhost:8080
}
:8080 {
    respond "Not Found" 404
}
EOF

systemctl restart caddy sing-box
systemctl enable caddy sing-box

# 8. 输出结果
clear
echo "========================================================="
echo "✅ 部署完成！"
echo "链接: anytls://$PASSWORD@$DOMAIN:443?sni=$DOMAIN&type=anytls#AnyTLS-阳谋"
echo "========================================================="
